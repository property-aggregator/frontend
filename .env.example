# Copy to .env.local and fill in. All variables are required.

# Backend API (called from the Next.js server only, never from the browser)
API_BASE_URL=http://localhost:5209

# Auth0 – "Regular Web Application"
AUTH0_DOMAIN=dev-80qfdf2a2flv03ea.eu.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Identifier of the API in Auth0; the backend rejects tokens without it
AUTH0_AUDIENCE=https://api.propertyaggregator
# Encrypts the session cookie. Generate with: openssl rand -hex 32
AUTH0_SECRET=

APP_BASE_URL=http://localhost:3000
